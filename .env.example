# EquiDrug — copy to deploy/.env or export before podman-compose up

# PostgreSQL
POSTGRES_USER=equidrug
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=equidrug
DATABASE_URL=postgres://equidrug:change-me-in-production@db:16127/equidrug?sslmode=disable

# API
API_PORT=16125
API_HOST=0.0.0.0
CORS_ORIGINS=https://equidrug.local,http://localhost:16126

# Frontend (build-time)
PUBLIC_API_URL=http://localhost:16125

